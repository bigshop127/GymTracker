# 複製此檔為 .env.local 並填入你的 Firebase 專案設定
# Firebase Console → 專案設定 → 你的應用程式 → SDK 設定與設定

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# 手機瀏覽器改走 Google Identity Services 登入（signInWithPopup/Redirect 在
# authDomain 跨網域時常被 Chrome 的第三方儲存限制擋下，見 src/sync/auth.ts）。
# 到 Google Cloud Console → APIs & Services → Credentials，找名稱含
# 「Web client (auto created by Google Service)」的 OAuth Client ID 填入。
VITE_GOOGLE_OAUTH_CLIENT_ID=123456789-abcdefg.apps.googleusercontent.com

# GitHub Pages 部署：將以上 7 個值加入 GitHub repo Settings → Secrets → Actions
# 並在 Actions workflow 的 env: 區塊使用 ${{ secrets.VITE_FIREBASE_* }} / VITE_GOOGLE_OAUTH_CLIENT_ID
